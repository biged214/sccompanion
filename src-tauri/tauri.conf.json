{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SC Companion",
  "version": "0.29.1",
  "identifier": "com.starcitizentrader.status",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SC Companion",
        "width": 1100,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Star Citizen news, reference data, trade planning, and local gameplay history.",
    "longDescription": "SC Companion combines Star Citizen service information, ships, components, commodity trade planning, and local Game.log session history in one desktop application.",
    "publisher": "SC Companion",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1Mjg0N0M5NkVDNEMwMkYKUldRdndNUnV5VWNveFZrbGdMNFJWOEVkMDh6OHNJM0twVUFmdGgrbGRHVXMydEtSSm0xb2xKOWkK",
      "endpoints": [
        "https://github.com/biged214/sccompanion/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

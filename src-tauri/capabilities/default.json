        {
          "url": "https://robertsspaceindustries.com/comm-link/*"
        },
        {
          "url": "https://robertsspaceindustries.com/en/comm-link/*"
        },
        {
          "url": "https://robertsspaceindustries.com/alexandria/*"
        },
        {
          "url": "https://robertsspaceindustries.com/en/community/orgs/*"
        },
        {
          "url": "https://robertsspaceindustries.com/en/orgs/*"
        },
        {

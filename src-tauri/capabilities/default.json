    "core:default",
    "notification:default",
    "autostart:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://support.robertsspaceindustries.com/api/v2/help_center/en-us/*" },

        { "url": "https://support.robertsspaceindustries.com/*" },
        { "url": "https://media.robertsspaceindustries.com/*" },
        { "url": "https://www.youtube.com/*" },
        { "url": "https://youtube.com/*" },
        { "url": "https://youtu.be/*" },
        { "url": "https://www.youtube-nocookie.com/*" },
